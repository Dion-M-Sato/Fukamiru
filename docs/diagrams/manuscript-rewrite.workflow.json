      "status": "parallel",
      "description": "重大指摘・未解決質問を対象別に再監査"
    },
    {
      "order": 32,
      "id": "validate_final_coherence",
      "label": "最終一貫性",
      "stage": "freeze",
      "resource_lane": "ingestion_cpu",
      "status": "guard",
      "description": "同じHTMLハッシュ上の品質証拠を集約"
